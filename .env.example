# Application Environment Configuration
ENVIRONMENT=development
DEBUG=True

# Host & Port
HOST=0.0.0.0
PORT=8000

# Database (Default local SQLite; Docker Compose uses PostgreSQL)
DATABASE_URL=sqlite:///./data/app.db
SYNC_DATABASE_URL=sqlite:///./data/app.db

# Task Queue (Redis + Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Vector DB & Embeddings
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# LLM Providers (stub, google_genai, openai)
LLM_PROVIDER=stub
GOOGLE_API_KEY=
OPENAI_API_KEY=
LLM_MODEL_NAME=gemini-1.5-flash
LLM_TEMPERATURE=0.0
CURRENT_PROMPT_VERSION=v2

# Observability
ENABLE_METRICS=True
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=bidshield-procurement-service
